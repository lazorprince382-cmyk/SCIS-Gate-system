DATABASE_URL=postgres://postgres:password@localhost:5432/gate
PORT=3001
JWT_SECRET=replace_with_a_long_random_secret_at_least_24_chars
JWT_EXPIRES_IN=8h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# For Render/managed Postgres with SSL, keep default behavior.
# Set PGSSL=false only if your local DB does not use TLS.
PGSSL=false

# Staff attendance (7:00 AM report time)
SCHOOL_TZ=Africa/Kampala
STAFF_REPORT_HOUR=7
STAFF_REPORT_MINUTE=0
STAFF_GRACE_MINUTES=0
